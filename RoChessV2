-- MATERIAL is indexed by piece type + 1 (index 1 = empty).
local MATERIAL = { 0, 100, 320, 330, 500, 900, 200000 }
local PIECE_NAMES = { [1] = "P", [2] = "N", [3] = "B", [4] = "R", [5] = "Q", [6] = "K" }
local MATE = 30000

