	toggle(AdvisorTab, "Auto Move", "autoMove", function(v)
		State.autoDoneKey = nil
		State.autoStatus = v and "Auto Move on." or "Auto Move off."
	end)

	AdvisorTab:CreateDivider({ text = "Board" })
	local statusText = AdvisorTab:CreateText({ name = "Status", text = "Waiting for game session…" })
	local engineText = AdvisorTab:CreateText({ name = "Engine Status", text = "Waiting for game session…" })

	AdvisorTab:CreateDivider({ text = "Analysis" })
	local turnMoveText = AdvisorTab:CreateText({
	    name = "BEST MOVE NOW — SIDE TO MOVE",
	    text = "Waiting for analysis..."
	})

	local clientText = AdvisorTab:CreateText({ name = "Client Best Move", text = "—" })
	local oppText = AdvisorTab:CreateText({ name = "Opponent Best Move", text = "—" })
	local evalText = AdvisorTab:CreateText({ name = "Material Evaluation", text = "—" })
	local analyzerText = AdvisorTab:CreateText({ name = "Independent Analyzer (White +)", text = "—" })
	local capturesText = AdvisorTab:CreateText({ name = "Top Captures", text = "—" })
	AdvisorTab:CreateButton({ name = "Refresh Now", callback = refreshOn })

	local function slider(name, range, inc, key, suffix, force)
		SettingsTab:CreateSlider({
			name = name,
			range = range,
			increment = inc,
			value = Config[key],
			suffix = suffix,
			forgetState = true,
			callback = function(v)
				Config[key] = v
				if force then State.forceRefresh = true end
			end,
		})
	end
	slider("Engine depth", { 5, 25 }, 1, "engineDepth", "", true)
	slider("Engine time", { 0.1, 3.0 }, 0.1, "engineTime", "s", true)
	slider("Poll rate", { 0.05, 1.0 }, 0.05, "pollRate", "s", false)
	slider("Max captures shown", { 3, 16 }, 1, "maxCapturesShown", "", true)
	slider("Tactic depth (plies)", { 2, 8 }, 1, "tacticDepth", "", true)
	toggle(SettingsTab, "Enable independent analyzer", "analyzerEnabled", refreshOn)
	slider("Analyzer depth", { 1, 5 }, 1, "analyzerDepth", "", true)
	slider("Analyzer time budget", { 0.03, 0.30 }, 0.01, "analyzerBudget", "s", true)

	toggle(PremoveTab, "Enable premove / tactical analysis", "premoveEnabled", function(v)
		State.forceRefresh = true
	end)
	local premoveText = PremoveTab:CreateText({ name = "Premove Analysis", text = "No active game." })
	local tacticsText = PremoveTab:CreateText({ name = "Tactical Sequences", text = "—" })
	PremoveTab:CreateButton({ name = "Recalculate", callback = refreshOn })
	PremoveTab:CreateDivider({ text = "How it works" })
	PremoveTab:CreateText({
		name = "Sequences",
		text = "Capture/recapture lines are searched on a scratch position. The independent analyzer adds a small positional evaluation and budget-limited alpha-beta search; the game's Bot.think remains the primary move engine. Scores are White-positive. FORCED = the opponent has one legal reply at every step; RECOMMENDED = clear material gain; SPECULATIVE = roughly even or cut off by the search limit.",
	})

	local function color(name, key)
		ColorsTab:CreateColorPicker({
			name = name,
			color = Config.colors[key],
			forgetState = true,
			callback = function(c)
				Config.colors[key] = c
				State.hlSig = nil
				if State.lastResult then applyHighlights(State.lastResult) end
			end,
		})
	end
	color("Your best move — from", "bestFrom")
	color("Your best move — to", "bestTo")
	color("Opponent predicted — from", "opponentFrom")
	color("Opponent predicted — to", "opponentTo")
	color("Favorable capture / trade", "captureGood")
	color("Unfavorable capture / trade", "captureBad")
	color("Premove — from", "premoveFrom")
	color("Premove — to", "premoveTo")

	ColorsTab:CreateButton({
		name = "Reset colors",
		callback = function()
			Config.colors = {
				bestFrom = Color3.fromRGB(46, 204, 113),
				bestTo = Color3.fromRGB(39, 174, 96),
				opponentFrom = Color3.fromRGB(231, 76, 60),
				opponentTo = Color3.fromRGB(192, 57, 43),
				captureGood = Color3.fromRGB(241, 196, 15),
				captureBad = Color3.fromRGB(155, 89, 182),
				premoveFrom = Color3.fromRGB(52, 152, 219),
				premoveTo = Color3.fromRGB(41, 128, 185),
			}
			State.hlSig = nil
			State.forceRefresh = true
		end,
	})

	local logConsole = LogTab:CreateConsole({ name = "Analysis Log", height = 320, follow = true, maxLines = 200 })

	return {
		Window = Window,
		statusText = statusText,
		engineText = engineText,
		turnMoveText = turnMoveText,
		clientText = clientText,
		oppText = oppText,
		evalText = evalText,
		analyzerText = analyzerText,
		capturesText = capturesText,
		premoveText = premoveText,
		tacticsText = tacticsText,
		logConsole = logConsole,
	}
end

-- ---------------------------------------------------------------------------
-- Entry point
-- ---------------------------------------------------------------------------
local function main()
	State.uiHandles = buildUI()
	logAdvisor(State.uiHandles, "RO-Chess Advisor loaded.")

	genv.__rochess_state.cleanup = function()
		Config.autoMove = false
		cancelEngineJob()
		pcall(clearAdvisorHighlights)
		local handles = State.uiHandles
		if handles and handles.Window and type(handles.Window.Unload) == "function" then
			pcall(function()
				handles.Window:Unload()
			end)
		end
	end

	task.spawn(function()
		while alive() do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[RO-Chess Advisor] refresh error: " .. tostring(err))
				pcall(unwindTo, getSession() and getSession().engine, 0)
			end
			task.wait(Config.pollRate)
		end
	end)
end

main()
