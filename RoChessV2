-- RO-Chess Advisor (Rayfield Gen2) v3
-- Persistent best-move analysis (client + opponent), tactical sequence / premove analysis,
-- and a gated Auto Move for bot games.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UiRoot = gethui and gethui() or game:GetService("CoreGui")

local Chess = ReplicatedStorage:WaitForChild("Chess")
local Engine = require(Chess:WaitForChild("Engine"))
local Bot = require(Chess:WaitForChild("Bot"))
local App = require(ReplicatedStorage:WaitForChild("ChessClient"):WaitForChild("App"))

-- Cross-execution cleanup. Each run owns a unique runId; old loops exit when it no longer matches.
local genv = getgenv()
local prev = genv.__rochess_state
if prev and type(prev.cleanup) == "function" then
	pcall(prev.cleanup)
end
local runId = {}
genv.__rochess_state = { runId = runId }
local function alive()
	return genv.__rochess_state ~= nil and genv.__rochess_state.runId == runId
end

-- Rayfield names the window frame "RO-Chess Advisor", not its ScreenGui.
-- Destroy each old window's generated ScreenGui so a rerun cannot leave a frozen UI behind.
local oldScreens = {}
for _, instance in ipairs(UiRoot:GetDescendants()) do
	if instance.Name == "RO-Chess Advisor" then
		local node = instance
		while node and node ~= UiRoot do
			if node:IsA("ScreenGui") and node.Name ~= "RobloxGui" then
				oldScreens[node] = true
				break
			end
			node = node.Parent
		end
	end
end
for screen in pairs(oldScreens) do
	pcall(function()
		screen:Destroy()
	end)
end

