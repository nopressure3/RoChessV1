	toggle(AdvisorTab, "Predict best moves (engine)", "predictOpponent", refreshOn)
	toggle(AdvisorTab, "Show capture recommendations", "captureHints", refreshOn)
	toggle(AdvisorTab, "Evaluate trades", "tradeEval", refreshOn)
	toggle(AdvisorTab, "Highlight on board", "highlightBoard", function(v)
		if not v then clearAdvisorHighlights() else State.forceRefresh = true end
	end)

