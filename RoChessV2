	local Window = Rayfield:CreateWindow({
		name = "RO-Chess Advisor",
		subtitle = "chess analysis and premove advisor",
		sidebarLayout = true,
	})

	local AdvisorTab = Window:CreateTab({ name = "Advisor", icon = "brain" })
	local SettingsTab = Window:CreateTab({ name = "Settings", icon = "settings" })
	local ColorsTab = Window:CreateTab({ name = "Colors", icon = "palette" })
	local PremoveTab = Window:CreateTab({ name = "Premove", icon = "move" })
	local LogTab = Window:CreateTab({ name = "Log", icon = "scroll-text" })

	local function toggle(tab, name, key, extra)
		tab:CreateToggle({
			name = name,
			value = Config[key],
			forgetState = true,
			callback = function(v)
				Config[key] = v
				State.hlSig = nil
				if extra then extra(v) end
			end,
		})
