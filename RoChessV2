-- ---------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------
local function getSession()
	return App.session
end

local function getBoard()
	return App.board
end

-- Real's identity 12 cannot write these CoreGui instances; identity 8 can.
-- Engine callbacks can arrive on a different identity, so normalize before UI work.
local function normalizeUiThread()
	if type(getthreadidentity) == "function" and type(setthreadidentity) == "function" then
		local ok, identity = pcall(getthreadidentity)
		if ok and identity ~= 8 then
			pcall(setthreadidentity, 8)
		end
	end
end

local function setIf(handle, key, text)
	if not handle or State.uiCache[key] == text then
		return
	end
	normalizeUiThread()
	local ok, err = pcall(function()
		handle:Set(text)
	end)
	if ok then
		-- Cache only successful writes; a failed update must be retried next render.
		State.uiCache[key] = text
	else
		warn("[RO-Chess Advisor] UI update failed for " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function squareName(index64)
	local file = string.char(97 + (index64 - 1) % 8)
	local rank = tostring(math.floor((index64 - 1) / 8) + 1)
	return file .. rank
end

local function squareIndex64(alg)
	local file = string.byte(alg:sub(1, 1)) - 97
	local rank = tonumber(alg:sub(2, 2)) - 1
	return rank * 8 + file + 1
end

-- App.onBoardMove uses display-square indices: a8 = 1, h1 = 64.
local function boardInputIndex(alg)
	local file = string.byte(alg:sub(1, 1)) - 97
	local rank = tonumber(alg:sub(2, 2))
	return (8 - rank) * 8 + file + 1
end

local function pieceName(value)
	return PIECE_NAMES[math.abs(value)] or "?"
end

local function pieceChar(value)
	if value == 0 then
		return "·"
	end
	return (value > 0 and "w" or "b") .. pieceName(value)
end

local function materialValue(piece)
	return MATERIAL[math.abs(piece) + 1] or 0
end

local function formatUciMove(uci)
	if type(uci) ~= "string" or #uci < 4 then
		return tostring(uci or "—")
	end
	local label = uci:sub(1, 2) .. " → " .. uci:sub(3, 4)
	if #uci > 4 then
		label = label .. "=" .. uci:sub(5, 5):upper()
	end
	return label
end

local function formatScore(score)
	if score == nil then
		return "—"
	end
	if score >= 29800 then
		return "+M" .. tostring(math.floor((30000 - score) / 2 + 0.5))
	end
	if score <= -29800 then
		return "-M" .. tostring(math.floor((30000 + score) / 2 + 0.5))
	end
	local s = score / 100
	if s == 0 then
		return "0.00"
	end
	return string.format("%+.2f", s)
end

local function formatDelta(d)
	if d >= 29000 then
		return "mate"
	elseif d <= -29000 then
		return "mated"
	end
	return formatScore(d)
end

local function copyArray(source)
	local result = {}
	for i, value in ipairs(source or {}) do
		result[i] = value
	end
	return result
end

local function positionKey(session)
	local ok, fen = pcall(function() return session.engine:getFen() end)
	return #session.ucis .. "|" .. (ok and fen or "?")
end

local function findLegalMoveByUci(engine, uci)
	if type(uci) ~= "string" then
		return nil
	end
	for _, move in ipairs(engine:legalMoves()) do
		if engine:moveToUci(move) == uci then
			return move
		end
	end
	return nil
end

local function gameOver(result)
	if result.legalCount == 0 then
		return true
	end
	local s = tostring(result.status or ""):lower()
	return s:find("mate") ~= nil or s:find("draw") ~= nil or s:find("resign") ~= nil or s:find("timeout") ~= nil
end

-- ---------------------------------------------------------------------------
-- Scratch moves on the live engine (always unwound; never yield while one is open)
-- ---------------------------------------------------------------------------
local scratchMade = 0

local function makeScratch(engine, move)
	engine:makeMove(move)
	scratchMade += 1
end

local function undoScratch(engine)
	engine:undoMove()
	scratchMade -= 1
end

local function unwindTo(engine, n)
	while scratchMade > n do
		scratchMade -= 1
		pcall(function() engine:undoMove() end)
	end
end

-- ---------------------------------------------------------------------------
-- Evaluation and tactical search
-- ---------------------------------------------------------------------------
local function kingShield(arr, idx, color)
	local f, r = (idx - 1) % 8, math.floor((idx - 1) / 8)
	local rr = r + color
	if rr < 0 or rr > 7 then
		return 0
	end
	local n = 0
	for df = -1, 1 do
		local ff = f + df
		if ff >= 0 and ff <= 7 and arr[rr * 8 + ff + 1] == color then
			n += 1
		end
	end
	return n
end

-- White-positive. withKing adds a small pawn-shield king-safety term.
local function evaluateStatic(engine, withKing)
	local arr = engine:boardArray()
	local score, wk, bk = 0, nil, nil
	for i = 1, 64 do
		local p = arr[i]
		if p and p ~= 0 then
			if p == 6 then
				wk = i
			elseif p == -6 then
				bk = i
			else
				score += (p > 0 and 1 or -1) * materialValue(p)
			end
		end
	end
	if withKing then
		if wk then score += 15 * kingShield(arr, wk, 1) end
		if bk then score -= 15 * kingShield(arr, bk, -1) end
	end
	return score
end

local function isTactical(engine, mv)
	if engine.board[Engine.moveTo(mv)] ~= 0 or Engine.moveFlag(mv) == Engine.F_EP then
		return true
	end
	if math.abs(engine.board[Engine.moveFrom(mv)]) == 1 then
		local _, to64 = Engine.moveSquares64(mv)
		local r = math.floor((to64 - 1) / 8)
		return r == 0 or r == 7
	end
	return false
end

local function describeMove(engine, mv)
	local mover = engine.board[Engine.moveFrom(mv)]
	local target = engine.board[Engine.moveTo(mv)]
	if target == 0 and Engine.moveFlag(mv) == Engine.F_EP then
		target = mover > 0 and -1 or 1
	end
	return {
		uci = engine:moveToUci(mv),
		mover = pieceName(mover),
		victim = target ~= 0 and pieceName(target) or nil,
		side = mover > 0 and 1 or -1,
	}
end

-- Lightweight positional evaluation. Scores are always White-positive.
-- It deliberately uses only boardArray() and the exposed board orientation.
local function evaluatePosition(engine)
	local arr = engine:boardArray()
	local score = 0
	local pawns = { [1] = {}, [-1] = {} }
	local bishops = { [1] = 0, [-1] = 0 }

	for i = 1, 64 do
		local piece = arr[i]
		if piece and piece ~= 0 then
			local color = piece > 0 and 1 or -1
			local kind = math.abs(piece)
			local file = (i - 1) % 8
			local rank = math.floor((i - 1) / 8)
			local relativeRank = color == 1 and rank or (7 - rank)
			local center = 7 - (math.abs(file - 3.5) + math.abs(rank - 3.5))
			local bonus = 0

			if kind == 1 then
				pawns[color][file] = (pawns[color][file] or 0) + 1
				bonus = relativeRank * 7 + center * 2
			elseif kind == 2 then
				bonus = center * 8
			elseif kind == 3 then
				bishops[color] += 1
				bonus = center * 4
			elseif kind == 4 then
				bonus = (relativeRank == 6 and 12 or 0) + center
			elseif kind == 5 then
				bonus = center * 2
			end

			if kind ~= 6 then
				score += color * (materialValue(piece) + bonus)
			end
		end
	end

	for _, color in ipairs({ 1, -1 }) do
		for file = 0, 7 do
			local count = pawns[color][file] or 0
			if count > 1 then
				score -= color * (count - 1) * 12
			end
			if count > 0 and (pawns[color][file - 1] or 0) == 0 and (pawns[color][file + 1] or 0) == 0 then
				score -= color * count * 10
			end
		end
		if bishops[color] >= 2 then
			score += color * 25
		end
	end

	-- Small king-shield term; avoid treating it as a decisive safety evaluation.
	local wk, bk
	for i = 1, 64 do
		if arr[i] == 6 then wk = i elseif arr[i] == -6 then bk = i end
	end
	if wk then score += 12 * kingShield(arr, wk, 1) end
	if bk then score -= 12 * kingShield(arr, bk, -1) end
	return score
end

-- Negamax over captures/promotions (all evasions when in check). Score is for the side to move.
local function qsearch(engine, depth, alpha, beta, ctx)
	local sign = engine.side == 1 and 1 or -1
	local stand = sign * evaluatePosition(engine)
	local moves = engine:legalMoves()
	local inCheck = engine:inCheck()
	if #moves == 0 then
		return inCheck and -MATE or 0, {}
	end
	if os.clock() > ctx.deadline then
		ctx.cut = true
		return stand, {}
	end
	if depth <= 0 and not inCheck then
		return stand, {}
	end
	local best, bestLine = -math.huge, {}
	if not inCheck then
		if stand >= beta then
			return stand, {}
		end
		best = stand
		if stand > alpha then
			alpha = stand
		end
	end
	for _, mv in ipairs(moves) do
		if inCheck or isTactical(engine, mv) then
			local entry = describeMove(engine, mv)
			entry.forced = #moves == 1
			makeScratch(engine, mv)
			local s, tail = qsearch(engine, depth - 1, -beta, -alpha, ctx)
			undoScratch(engine)
			s = -s
			if s > best then
				best = s
				bestLine = { entry }
				for _, e in ipairs(tail) do
					table.insert(bestLine, e)
				end
			end
			if s > alpha then
				alpha = s
			end
			if alpha >= beta then
				break
			end
		end
	end
	return best, bestLine
end

-- Independent, budget-limited negamax search. It shares only the game's legal-move
-- and make/undo interface; Bot.think remains the primary move recommendation.
local function independentSearch(engine)
	if not Config.analyzerEnabled then
		return nil
	end

	local base = scratchMade
	local rootSide = engine.side
	local ctx = {
		deadline = os.clock() + Config.analyzerBudget,
		nodes = 0,
		cut = false,
		maxNodes = 3500,
	}
	local function evaluateForTurn()
		return (engine.side == 1 and 1 or -1) * evaluatePosition(engine)
	end

	local function orderedMoves(moves)
		local scored = {}
		for _, mv in ipairs(moves) do
			local from = engine.board[Engine.moveFrom(mv)]
			local to = engine.board[Engine.moveTo(mv)]
			local score = 0
			if to ~= 0 then
				score += 10000 + materialValue(to) * 10 - materialValue(from)
			elseif Engine.moveFlag(mv) == Engine.F_EP then
				score += 10100
			end
			local uci = engine:moveToUci(mv)
			if #uci > 4 then score += 9000 end
			table.insert(scored, { move = mv, score = score })
		end
		table.sort(scored, function(a, b) return a.score > b.score end)
		local result = {}
		for _, item in ipairs(scored) do table.insert(result, item.move) end
		return result
	end

	local function search(depth, alpha, beta, ply)
		ctx.nodes += 1
		if os.clock() >= ctx.deadline or ctx.nodes >= ctx.maxNodes then
			ctx.cut = true
			return evaluateForTurn(), nil
		end

		local moves = engine:legalMoves()
		local inCheck = engine:inCheck()
		if #moves == 0 then
			return inCheck and (-MATE + ply) or 0, nil
		end
		if depth <= 0 then
			local score = qsearch(engine, Config.analyzerQDepth, alpha, beta, ctx)
			return score, nil
		end

		local bestScore = -math.huge
		local bestUci = nil
		for _, mv in ipairs(orderedMoves(moves)) do
			if os.clock() >= ctx.deadline or ctx.nodes >= ctx.maxNodes then
				ctx.cut = true
				break
			end
			local uci = engine:moveToUci(mv)
			makeScratch(engine, mv)
			local childScore = search(depth - 1, -beta, -alpha, ply + 1)
			undoScratch(engine)
			local score = -childScore
			if score > bestScore then
				bestScore = score
				bestUci = uci
			end
			if score > alpha then alpha = score end
			if alpha >= beta then break end
			if ctx.cut then break end
		end
		if bestScore == -math.huge then
			bestScore = evaluateForTurn()
		end
		return bestScore, bestUci
	end

	local best = nil
	local ok, err = pcall(function()
		for depth = 1, Config.analyzerDepth do
			if os.clock() >= ctx.deadline then break end
			ctx.cut = false
			local score, uci = search(depth, -math.huge, math.huge, 0)
			if not ctx.cut and uci then
				best = {
					uci = uci,
					scoreWhite = score * rootSide,
					depth = depth,
					nodes = ctx.nodes,
					time = os.clock() - (ctx.deadline - Config.analyzerBudget),
				}
			else
				break
			end
		end
	end)
	unwindTo(engine, base)
	if not ok then
		warn("[RO-Chess Advisor] independent analyzer failed: " .. tostring(err))
		return { error = tostring(err), nodes = ctx.nodes }
	end
	if best then
		best.complete = true
		return best
	end
	return {
		scoreWhite = evaluatePosition(engine),
		depth = 0,
		nodes = ctx.nodes,
		time = Config.analyzerBudget,
		complete = false,
	}
end

-- Tactical lines for the side to move. Returns sorted lines and a map root-uci -> line.
local function tacticsFor(engine)
	local base = scratchMade
	local sign = engine.side == 1 and 1 or -1
	local before = sign * evaluateStatic(engine, true)
	local ctx = { deadline = os.clock() + Config.tacticBudget, cut = false }
	local lines, byRoot = {}, {}

	local ok, err = pcall(function()
		for _, mv in ipairs(engine:legalMoves()) do
			if isTactical(engine, mv) then
				if os.clock() > ctx.deadline then
					break
				end
				ctx.cut = false
				local entry = describeMove(engine, mv)
				makeScratch(engine, mv)
				local s, tail = qsearch(engine, Config.tacticDepth - 1, -math.huge, math.huge, ctx)
				undoScratch(engine)
				table.insert(tail, 1, entry)

				local delta = -s - before
				-- forced = the opponent had exactly one legal reply at every opponent ply in the line
				local oppPlies, forced = 0, true
				for i = 2, #tail do
					if tail[i].side ~= entry.side then
						oppPlies += 1
						if not tail[i].forced then
							forced = false
						end
					end
				end
				forced = forced and oppPlies > 0
				local tag
				if forced and delta >= 0 then
					tag = "FORCED"
				elseif delta >= 100 and not ctx.cut then
					tag = "RECOMMENDED"
				elseif delta >= -50 then
					tag = "SPECULATIVE"
				else
					tag = "UNFAVORABLE"
				end
				local line = { root = entry.uci, moves = tail, delta = delta, tag = tag }
				table.insert(lines, line)
				byRoot[entry.uci] = line
			end
		end
	end)
	unwindTo(engine, base)
	if not ok then
		warn("[RO-Chess Advisor] tactics failed: " .. tostring(err))
	end
	table.sort(lines, function(a, b)
		return a.delta > b.delta
	end)
	while #lines > Config.maxSequences do
		table.remove(lines)
	end
	return lines, byRoot
end

-- ---------------------------------------------------------------------------
-- Board highlighting
-- ---------------------------------------------------------------------------
local SEQ_MAX = 6

local function clearAdvisorHighlights()
	local board = getBoard()
	if not board then
		return
	end
	local keys = {
		"AdvisorBestFrom", "AdvisorBestTo", "AdvisorOppFrom", "AdvisorOppTo",
		"AdvisorPremoveFrom", "AdvisorPremoveTo",
	}
	for i = 1, 16 do
		table.insert(keys, "AdvisorCapture" .. i)
	end
	for _, key in ipairs(keys) do
		board:setTint(key, nil)
	end
	board:setArrow("AdvisorBestArrow", nil)
	board:setArrow("AdvisorOppArrow", nil)
	board:setArrow("AdvisorPremoveArrow", nil)
	for i = 1, SEQ_MAX do
		board:setArrow("AdvisorSeq" .. i, nil)
	end
	State.hlSig = nil
end

local function applyHighlights(result)
	if not Config.highlightBoard then
		return
	end
	local board = getBoard()
	if not board then
		return
	end
	if not result then
		clearAdvisorHighlights()
		return
	end

	local topLine = result.isMyTurn and result.tactics and result.tactics[1] or (result.premove and result.premove[1])
	local sig = table.concat({
		result.key,
		result.clientMove and result.clientMove.uci or "-",
		result.oppMove and result.oppMove.uci or "-",
		topLine and topLine.root or "-",
		topLine and #topLine.moves or 0,
		Config.captureHints and "c" or "n",
	}, "|")
	if State.hlSig == sig then
		return
	end
	clearAdvisorHighlights()
	State.hlSig = sig

	local function squaresOf(uci)
		return squareIndex64(uci:sub(1, 2)), squareIndex64(uci:sub(3, 4))
	end

	if result.clientMove and #result.clientMove.uci >= 4 then
		local f, t = squaresOf(result.clientMove.uci)
		board:setTint("AdvisorBestFrom", f, Config.colors.bestFrom, 0.4)
		board:setTint("AdvisorBestTo", t, Config.colors.bestTo, 0.4)
		board:setArrow("AdvisorBestArrow", f, t, Config.colors.bestFrom, 0.35)
	end
	if result.oppMove and #result.oppMove.uci >= 4 then
		local f, t = squaresOf(result.oppMove.uci)
		board:setTint("AdvisorOppFrom", f, Config.colors.opponentFrom, 0.4)
		board:setTint("AdvisorOppTo", t, Config.colors.opponentTo, 0.4)
		board:setArrow("AdvisorOppArrow", f, t, Config.colors.opponentFrom, 0.35)
	end

	if Config.premoveEnabled and topLine then
		if not result.isMyTurn then
			local f, t = squaresOf(topLine.root)
			board:setTint("AdvisorPremoveFrom", f, Config.colors.premoveFrom, 0.5)
			board:setTint("AdvisorPremoveTo", t, Config.colors.premoveTo, 0.5)
		end
		for i = 1, math.min(SEQ_MAX, #topLine.moves) do
			local m = topLine.moves[i]
			local f, t = squaresOf(m.uci)
			local mine = m.side == result.myColor
			board:setArrow("AdvisorSeq" .. i, f, t, mine and Config.colors.premoveFrom or Config.colors.opponentFrom, 0.45)
		end
	end

	if Config.captureHints then
		for i = 1, math.min(Config.maxCapturesShown, #result.captures) do
			local cap = result.captures[i]
			local color = Config.colors.captureGood
			if Config.tradeEval and result.trades[i] and result.trades[i].verdict == "unfavorable" then
				color = Config.colors.captureBad
			end
			board:setTint("AdvisorCapture" .. i, squareIndex64(cap.to), color, 0.35)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Core analysis (synchronous, cheap)
-- ---------------------------------------------------------------------------
local function analyzePosition(session, key)
	local engine = session.engine
	local side = engine.side
	if session.myColor ~= nil then
		State.detectedMyColor = session.myColor
	elseif State.detectedMyColor == nil then
		State.detectedMyColor = side
	end
	local myColor = session.myColor or State.detectedMyColor or side
	local legal = engine:legalMoves()
	local ucis = session.ucis

	local result = {
		key = key,
		fen = engine:getFen(),
		side = side,
		myColor = myColor,
		isMyTurn = side == myColor,
		ply = #ucis,
		fullmove = engine.fullmove,
		status = engine:status(),
		inCheck = engine:inCheck(),
		legalCount = #legal,
		captures = {},
		trades = {},
		material = evaluateStatic(engine, false),
	}

	local pred = State.prediction
	if result.isMyTurn and pred and pred.ply == #ucis - 1 then
		local played = ucis[#ucis]
		result.predictionNote = played == pred.uci
			and ("Prediction hit: opponent played " .. played)
			or ("Prediction missed: expected " .. tostring(pred.uci) .. ", opponent played " .. tostring(played))
	end

	for _, move in ipairs(legal) do
		local from64, to64 = Engine.moveSquares64(move)
		local target = engine.board[Engine.moveTo(move)]
		local isEp = Engine.moveFlag(move) == Engine.F_EP
		if target ~= 0 or isEp then
			local fromPiece = engine.board[Engine.moveFrom(move)]
			local victim = isEp and (side == 1 and -1 or 1) or target
			table.insert(result.captures, {
				uci = engine:moveToUci(move),
				from = squareName(from64),
				to = squareName(to64),
				attacker = pieceChar(fromPiece),
				victim = pieceChar(victim),
				gain = materialValue(victim) - materialValue(fromPiece),
			})
		end
	end
	table.sort(result.captures, function(a, b)
		return a.gain > b.gain
	end)

	result.analyzer = independentSearch(engine)

	local lines, byRoot = tacticsFor(engine)
	result.tactics = lines

	-- Immediate tactical best moves (shown before engine completes)
	local topTactic = lines[1]
	if topTactic then
		local info = { depth = Config.tacticDepth, time = Config.tacticBudget, score = topTactic.delta }
		if result.isMyTurn then
			result.clientMove = { uci = topTactic.root, info = info, source = "tactical" }
		else
			result.oppMove = { uci = topTactic.root, info = info, source = "tactical" }
		end
	end

	-- When it's opponent's turn, also compute our best reply (premove) after their predicted move
	if not result.isMyTurn and Config.premoveEnabled then
		local oppPredictedUci = topTactic and topTactic.root or (State.prediction and State.prediction.uci)
		if oppPredictedUci then
			local mv = findLegalMoveByUci(engine, oppPredictedUci)
			if mv then
				local base = scratchMade
				local okp = pcall(function()
					makeScratch(engine, mv)
					local replyLines = tacticsFor(engine)
					local topReply = replyLines[1]
					if topReply then
						local info = { depth = Config.tacticDepth, time = Config.tacticBudget, score = topReply.delta }
						result.clientMove = { uci = topReply.root, info = info, source = "tactical" }
					end
					undoScratch(engine)
				end)
				unwindTo(engine, base)
			end
		end
	end

	-- Never reuse a move from an older position. Quiet positions have no tactical
	-- root, so the current engine job fills these fields when its result is ready.

	if Config.tradeEval then
		for i = 1, math.min(Config.maxCapturesShown, #result.captures) do
			local cap = result.captures[i]
			local line = byRoot[cap.uci]
			local delta = line and line.delta or 0
			table.insert(result.trades, { uci = cap.uci, delta = delta, verdict = delta >= 0 and "favorable" or "unfavorable" })
		end
	end
	return result
end

-- ---------------------------------------------------------------------------
-- UI update helpers
-- ---------------------------------------------------------------------------
local function formatTactic(line, myColor)
	local parts = { string.format("[%s] %s", line.tag, formatDelta(line.delta)) }
	for i, m in ipairs(line.moves) do
		local who = m.side == myColor and "you" or "opp"
		local what = m.mover .. (m.victim and ("x" .. m.victim) or "")
		local sq = m.uci:sub(1, 2) .. "→" .. m.uci:sub(3, 4) .. (#m.uci > 4 and ("=" .. m.uci:sub(5):upper()) or "")
		table.insert(parts, string.format("  %d. %s %s %s%s", i, who, what, sq, m.forced and " (forced)" or ""))
	end
	return table.concat(parts, "\n")
end

local function formatTacticList(title, lines, myColor, limit)
	if not lines or #lines == 0 then
		return title .. ": no forcing captures."
	end
	local out = { title .. ":" }
	for i = 1, math.min(limit or #lines, #lines) do
		table.insert(out, formatTactic(lines[i], myColor))
	end
	return table.concat(out, "\n")
end

updateBoardUI = function(ui, result)
	if not result then
		setIf(ui.statusText, "status", "No active game session.")
		return
	end
	local sideName = result.side == 1 and "White" or "Black"
	local turnText = result.isMyTurn and ("Your turn — " .. sideName) or ("Opponent's turn — " .. sideName)
	setIf(ui.statusText, "status", turnText .. " | Ply " .. result.ply .. " | " .. tostring(result.status) .. (result.inCheck and " | CHECK" or ""))
end

updateAnalysisUI = function(ui, result)
	if not result then
		setIf(ui.turnMoveText, "turnMove", "Waiting for analysis...")
		setIf(ui.clientText, "client", "—")
		setIf(ui.oppText, "opp", "—")
		setIf(ui.evalText, "eval", "—")
		setIf(ui.analyzerText, "analyzer", "—")
		setIf(ui.capturesText, "caps", "—")
		return
	end
	local function moveLine(m, note)
		if m then
			local info = m.info or {}
			local src = m.source and ("  [" .. m.source .. "]") or ""
			return formatUciMove(m.uci) .. "  [" .. m.uci .. "]"
				.. (info.depth and ("  d" .. info.depth) or "")
				.. (info.time and string.format("  %.2fs", info.time) or "")
				.. src .. note
		end
		if not Config.predictOpponent then
			return "Engine analysis off"
		end
		if State.computing then
			return "Analyzing…"
		end
		return result.analysisError and ("Unavailable: " .. result.analysisError) or "—"
	end
	-- Always show best moves for both sides regardless of turn
	local clientNote = result.isMyTurn and "  (your turn)" or "  (after opponent)"
	local oppNote = result.isMyTurn and "  (opponent reply)" or "  (opponent turn)"
	local currentTurnMove = result.turnMove

	if not currentTurnMove and result.tactics and result.tactics[1] then
	    currentTurnMove = {
	        uci = result.tactics[1].root,
	        info = {
	            depth = Config.tacticDepth,
	            time = Config.tacticBudget
	        },
	        source = "tactical"
	    }
	end

	local sideName = result.side == 1 and "WHITE" or "BLACK"

	setIf(
	    ui.turnMoveText,
	    "turnMove",
	    sideName .. " TO MOVE: " .. moveLine(currentTurnMove, "")
	)

	setIf(ui.clientText, "client", moveLine(result.clientMove, clientNote))
	setIf(ui.oppText, "opp", moveLine(result.oppMove, oppNote))

	local mySign = result.myColor == 1 and 1 or -1
	local engineScore = result.mainMove and result.mainMove.score
	setIf(ui.evalText, "eval", "Material: " .. formatScore(mySign * result.material) .. " (you)  |  Engine: " .. formatScore(engineScore) .. " (side to move)")

	local analyzer = result.analyzer
	if analyzer and analyzer.error then
		setIf(ui.analyzerText, "analyzer", "Analyzer error: " .. analyzer.error)
	elseif analyzer then
		local score = tonumber(analyzer.scoreWhite) or 0
		local clipped = math.max(-500, math.min(500, score))

		local whiteBlocks = math.floor(((clipped + 500) / 1000) * 20 + 0.5)
		local blackBlocks = 20 - whiteBlocks

		local bar = string.rep("█", whiteBlocks)
			.. string.rep("░", blackBlocks)

		local moveText = analyzer.uci
			and (" | Best: " .. formatUciMove(analyzer.uci))
			or ""

		local depthText = analyzer.complete
			and ("Depth " .. analyzer.depth)
			or "Static/partial"

		setIf(
			ui.analyzerText,
			"analyzer",
			"WHITE  [" .. bar .. "]  BLACK"
			.. "\nEvaluation: " .. formatScore(score)
			.. " | " .. depthText
			.. " | " .. tostring(analyzer.nodes or 0) .. " nodes"
			.. moveText
		)
	else
		setIf(ui.analyzerText, "analyzer", "Independent analyzer disabled.")
	end

	if #result.captures > 0 and Config.captureHints then
		local lines = {}
		for i = 1, math.min(Config.maxCapturesShown, #result.captures) do
			local c = result.captures[i]
			local trade = ""
			local t = Config.tradeEval and result.trades[i]
			if t then
				trade = "  " .. (t.verdict == "favorable" and "✅" or "⚠️") .. " " .. formatDelta(t.delta)
			end
			table.insert(lines, string.format("%s  %sx%s  %+d%s", formatUciMove(c.uci), c.attacker, c.victim, c.gain, trade))
		end
		setIf(ui.capturesText, "caps", table.concat(lines, "\n"))
	else
		setIf(ui.capturesText, "caps", Config.captureHints and "No captures available." or "Capture hints disabled.")
	end
end

updateTacticsUI = function(ui, result)
	if not result then
		setIf(ui.premoveText, "premove", "No active game.")
		setIf(ui.tacticsText, "tactics", "—")
		return
	end

	local pre = {}
	if not Config.premoveEnabled then
		pre = { "Premove analysis disabled." }
	elseif result.isMyTurn then
		table.insert(pre, "Your turn — tactics below are for the current position.")
		if result.predictionNote then
			table.insert(pre, result.predictionNote)
		end
	else
		local predicted = result.mainMove and result.mainMove.uci
		if not predicted then
			table.insert(pre, State.computing and "Predicting opponent move…" or "No opponent prediction available.")
		else
			table.insert(pre, "Predicted opponent move: " .. formatUciMove(predicted))
			local top = result.premove and result.premove[1]
			if top then
				table.insert(pre, string.format("Best premove line: [%s] %s starting %s", top.tag, formatDelta(top.delta), formatUciMove(top.root)))
			else
				table.insert(pre, "No forcing continuation after that move.")
			end
			if result.clientMove then
				table.insert(pre, "Engine reply: " .. formatUciMove(result.clientMove.uci))
			end
		end
	end
	setIf(ui.premoveText, "premove", table.concat(pre, "\n"))

	local text
	if not Config.premoveEnabled then
		text = formatTacticList("Your tactics", result.isMyTurn and result.tactics or nil, result.myColor)
	elseif result.isMyTurn then
		text = formatTacticList("Your tactics", result.tactics, result.myColor)
	else
		text = formatTacticList("Opponent threats", result.tactics, result.myColor, 2)
			.. "\n\n" .. formatTacticList("Premove (after predicted move)", result.premove, result.myColor)
	end
	setIf(ui.tacticsText, "tactics", text)
end

updateEngineStatus = function(ui)
	local result = State.lastResult
	local line
	if not Config.predictOpponent then
		line = "Engine analysis off."
	elseif not result then
		line = "Waiting for game session…"
	elseif State.computing then
		line = string.format("Thinking… ply %d (d%d, %.1fs)", result.ply, Config.engineDepth, Config.engineTime)
	elseif result.analysisError then
		line = "Error: " .. result.analysisError
	elseif gameOver(result) then
		line = "Game over — analysis stopped."
	else
		line = "Idle — analysis current (ply " .. result.ply .. ")."
	end
	setIf(ui.engineText, "engine", line .. "\n" .. State.autoStatus)
end

local function renderAll(ui, result)
	normalizeUiThread()
	updateBoardUI(ui, result)
	updateAnalysisUI(ui, result)
	updateTacticsUI(ui, result)
	applyHighlights(result)
	updateEngineStatus(ui)
end

logAdvisor = function(ui, msg)
	normalizeUiThread()
	if ui and ui.logConsole then
		ui.logConsole:Append("[" .. os.date("%H:%M:%S") .. "] " .. msg)
	end
end

-- ---------------------------------------------------------------------------
-- Engine job: best move for side to move, then best reply (the other side's best move)
-- ---------------------------------------------------------------------------
local function cancelEngineJob()
	State.jobGeneration += 1
	if State.cancelToken then
		State.cancelToken.cancelled = true
		State.cancelToken = nil
	end
	State.computing = false
end

local function startJob(session, result)
	cancelEngineJob()
	local key = result.key
	local generation = State.jobGeneration
	local token = { cancelled = false }
	State.cancelToken = token
	State.computing = true
	State.jobStarted = os.clock()

	local function current()
		return alive() and not token.cancelled and generation == State.jobGeneration
			and getSession() == session and positionKey(session) == key
	end

	local function think(fen, hist)
		for attempt = 0, Config.retries do
			local ok, uci, info = pcall(Bot.think, fen, hist, {
				rating = 3200, depth = Config.engineDepth, time = Config.engineTime,
			}, token)
			if not current() then
				return nil, nil, true
			end
			if ok and uci then
				return uci, info or {}, false
			end
			result.analysisError = ok and "engine returned no move" or tostring(uci)
			task.wait(0.2 * (attempt + 1))
			if not current() then
				return nil, nil, true
			end
		end
		return nil, nil, false
	end

	local function push()
		if State.lastResult == result and State.uiHandles then
			renderAll(State.uiHandles, result)
		end
	end

	task.spawn(function()
		local ok, err = pcall(function()
			local mine = result.isMyTurn
			local mainUci, mainInfo, stale = think(result.fen, copyArray(session.ucis))
			if stale or not mainUci then
				return
			end
			result.analysisError = nil
			result.mainMove = { uci = mainUci, info = mainInfo, score = mainInfo.score, source = "engine" }
			result.turnMove = result.mainMove
			if mine then
				result.clientMove = result.mainMove
			else
				result.oppMove = result.mainMove
				State.prediction = { ply = result.ply, uci = mainUci }
			end

			-- Position after the main move (also premove tactics when it's the opponent's turn).
			local engine = session.engine
			local mv = findLegalMoveByUci(engine, mainUci)
			local afterFen
			if mv then
				local base = scratchMade
				local okp, errp = pcall(function()
					makeScratch(engine, mv)
					afterFen = engine:getFen()
					if not mine and Config.premoveEnabled then
						result.premove = (tacticsFor(engine))
					end
					undoScratch(engine)
				end)
				unwindTo(engine, base)
				if not okp then
					warn("[RO-Chess Advisor] follow-up position failed: " .. tostring(errp))
					afterFen = nil
				end
			end
			push()
			if not afterFen then
				return
			end

			local hist = copyArray(session.ucis)
			table.insert(hist, mainUci)
			local replyUci, replyInfo, stale2 = think(afterFen, hist)
			if stale2 or not replyUci then
				return
			end
			result.replyMove = { uci = replyUci, info = replyInfo, score = replyInfo.score, source = "engine" }
			if mine then
				result.oppMove = result.replyMove
			else
				result.clientMove = result.replyMove
			end
			push()
		end)
		if not ok then
			warn("[RO-Chess Advisor] engine job error: " .. tostring(err))
			result.analysisError = tostring(err)
		end
		if State.cancelToken == token then
			State.computing = false
			State.cancelToken = nil
		end
		push()
	end)
end

-- ---------------------------------------------------------------------------
-- Auto Move
-- ---------------------------------------------------------------------------
local function botGameState(session)
	for _, k in ipairs({ "isBot", "vsBot", "botGame", "isBotGame", "bot" }) do
		local v = session[k]
		if v ~= nil then
			return v and true or false
		end
	end
	local mode = session.mode
	if type(mode) == "string" then
		local m = mode:lower()
		if m:find("bot") or m:find("computer") then
			return true
		end
		if m:find("pvp") or m:find("online") or m:find("ranked") or m:find("multiplayer") then
			return false
		end
	end
	return nil
end

-- FILL: if none of these names match the client's real move call, set genv.RoChessMoveFn = function(uci) ... end
-- (or replace MOVE_NAMES with the actual method on session / ChessClient.App).
local MOVE_NAMES = { "playUci", "playMove", "submitMove", "tryMove", "sendMove", "move" }

local function resolveMover(session)
	if type(genv.RoChessMoveFn) == "function" then
		return genv.RoChessMoveFn, "RoChessMoveFn"
	end
	for _, name in ipairs(MOVE_NAMES) do
		if type(session[name]) == "function" then
			return function(u) return session[name](session, u) end, "session." .. name
		end
	end
	-- Bot games use the board-input path; playMove/submitMove only send online moves.
	if session.kind == "bot" and type(App.onBoardMove) == "function" then
		local promotions = { q = 5, r = 4, b = 3, n = 2 }
		return function(u)
			local from = boardInputIndex(u:sub(1, 2))
			local to = boardInputIndex(u:sub(3, 4))
			local promotion = promotions[u:sub(5, 5):lower()]
			return App.onBoardMove(from, to, promotion)
		end, "App.onBoardMove"
	end
	for _, name in ipairs(MOVE_NAMES) do
		if type(App[name]) == "function" then
			-- App.playMove and App.submitMove are aliases of sendUci(uci), not methods.
			return function(u) return App[name](u) end, "App." .. name
		end
	end
	return nil
end

local function autoMoveTick()
	if not Config.autoMove or State.autoBusy then
		return
	end
	local session, result = getSession(), State.lastResult
	if not session or not result then
		return
	end
	if gameOver(result) then
		State.autoStatus = "Auto Move: game over, idle."
		return
	end
	-- For bot games, auto-move on our turn using the best available move (clientMove or tactical)
	local uci = result.clientMove and result.clientMove.uci
	if not uci and result.tactics and result.tactics[1] then
		uci = result.tactics[1].root
	end
	if not result.isMyTurn or not uci then
		return
	end
	local key = positionKey(session)
	if key ~= result.key or State.autoDoneKey == key then
		return
	end
	-- Auto-move on our turn when we have a best move (no bot game check)
	if not findLegalMoveByUci(session.engine, uci) then
		State.autoStatus = "Auto Move: recommended move is not legal, waiting."
		return
	end
	local mover, via = resolveMover(session)
	if not mover then
		State.autoStatus = "Auto Move: no move interface found (set getgenv().RoChessMoveFn)."
		Config.autoMove = false
		return
	end

	State.autoBusy = true
	State.autoDoneKey = key
	State.autoStatus = "Auto Move: playing " .. uci .. "…"
	task.spawn(function()
		task.wait(Config.autoDelay)
		local s = getSession()
		if not alive() or not Config.autoMove or s ~= session or positionKey(s) ~= key then
			State.autoDoneKey = nil
			State.autoBusy = false
			State.autoStatus = Config.autoMove and "Auto Move: board changed, re-evaluating." or "Auto Move off."
			return
		end
		local plyBefore = #s.ucis
		local ok, err = pcall(mover, uci)
		local confirmed = false
		local deadline = os.clock() + 3
		while ok and alive() and os.clock() < deadline do
			local cs = getSession()
			if cs ~= session then
				break
			end
			if #cs.ucis > plyBefore then
				confirmed = cs.ucis[plyBefore + 1] == uci
				break
			end
			task.wait(0.05)
		end
		if not ok then
			State.autoStatus = "Auto Move failed: " .. tostring(err)
		elseif confirmed then
			State.autoStatus = "Auto Move: played " .. uci .. " via " .. via .. "."
		else
			State.autoStatus = "Auto Move: " .. uci .. " not confirmed; not retrying this position."
		end
		logAdvisor(State.uiHandles, State.autoStatus)
		State.autoBusy = false
	end)
end

-- ---------------------------------------------------------------------------
-- Main refresh loop
-- ---------------------------------------------------------------------------
local function refresh()
	if not Config.enabled then
		return
	end
	local ui = State.uiHandles
	if not ui then
		return
	end

	local session = getSession()
	if not session or not session.engine then
		if State.lastSession then
			cancelEngineJob()
			State.lastSession = nil
			State.lastKey = nil
			State.lastResult = nil
			State.detectedMyColor = nil
			State.prediction = nil
			State.autoDoneKey = nil
			clearAdvisorHighlights()
			renderAll(ui, nil)
		end
		return
	end

	local key = positionKey(session)

	if State.computing and os.clock() - State.jobStarted > Config.staleTimeout then
		logAdvisor(ui, "Engine job timed out; restarting.")
		cancelEngineJob()
		State.forceRefresh = true
	end

	local changed = State.lastSession ~= session or State.lastKey ~= key or State.forceRefresh
	if not changed or (not Config.autoUpdate and not State.forceRefresh and State.lastSession == session) then
		updateEngineStatus(ui)
		autoMoveTick()
		return
	end

	State.lastSession = session
	State.lastKey = key
	State.forceRefresh = false
	cancelEngineJob()

	local ok, result = pcall(analyzePosition, session, key)
	unwindTo(session.engine, 0)
	if not ok then
		warn("[RO-Chess Advisor] analyze error: " .. tostring(result))
		State.lastKey = nil -- retry next tick
		return
	end

	State.lastResult = result
	renderAll(ui, result)
	if Config.predictOpponent and not gameOver(result) then
		startJob(session, result)
		updateEngineStatus(ui)
	end
	logAdvisor(ui, string.format("Ply %d — %s to move", result.ply, result.side == 1 and "White" or "Black"))
	autoMoveTick()
end

